# Flask Configuration
FLASK_APP=wsgi.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=voxmind-dev-secret-key-change-in-production-min32chars
JWT_SECRET_KEY=voxmind-jwt-secret-key-change-in-production-min32chars
PORT=5000

# Database (PostgreSQL)
# For local dev without docker, SQLite can also be used via sqlite:///voxmind.db
DATABASE_URL=postgresql://voxmind_user:voxmind_password@localhost:5432/voxmind_db

# Queue & Cache (Redis / Celery)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# When CELERY_TASK_ALWAYS_EAGER=true, tasks run synchronously (ideal for testing & standalone dev)
CELERY_TASK_ALWAYS_EAGER=false

# AI Services
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Storage & Upload Limits
STORAGE_PATH=./storage
UPLOAD_DIR=./storage/uploads
MAX_CONTENT_LENGTH=104857600  # 100MB in bytes

# Security & CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30
