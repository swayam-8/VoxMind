# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Database & Queue Configuration
MONGO_URI=mongodb://localhost:27017/voxmind
REDIS_URL=redis://localhost:6379/0

# Security & Authentication (in production, generate a secure random 32+ character string)
JWT_SECRET=your-secure-random-32-plus-character-secret-key-here
JWT_EXPIRES_IN=7d

# Local AI Microservice URL
AI_SERVICE_URL=http://127.0.0.1:8001

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=100
CORS_ORIGIN=http://localhost:5173

# Meeting recording imports (all credentials stay server-side)
# Generate the 64-hex-character encryption key with: npm run integrations:key
INTEGRATION_ENCRYPTION_KEY=
INTEGRATIONS_API_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WEBEX_CLIENT_ID=
WEBEX_CLIENT_SECRET=
