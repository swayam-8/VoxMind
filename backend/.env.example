# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Database & Queue Configuration
MONGO_URI=mongodb://localhost:27017/voxmind
REDIS_URL=redis://localhost:6379/0

# Security & Authentication (in production, generate a secure random 32+ character string)
JWT_SECRET=your-secure-random-32-plus-character-secret-key-here
JWT_EXPIRES_IN=7d

# Local AI Microservice URL
AI_SERVICE_URL=http://127.0.0.1:8000

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=100
CORS_ORIGIN=http://localhost:5173
