# ==============================================================================
# VoxMind — Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting services:
#   cp .env.example .env
# ==============================================================================

# Node / Backend Configuration
NODE_ENV=production
PORT=5000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Database & Cache
MONGO_URI=mongodb://mongo:27017/voxmind
REDIS_URL=redis://redis:6379/0

# Security (JWT Authentication)
# IMPORTANT: In production, generate a secure random 32+ character key:
#   openssl rand -hex 32
JWT_SECRET=voxmind-change-me-to-a-secure-random-32-plus-char-secret-key-12345
JWT_EXPIRES_IN=7d

# File Storage
UPLOAD_DIR=/app/storage/uploads
MAX_UPLOAD_SIZE_MB=100

# Local AI Microservice URL (FastAPI)
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://ai_service:8000

# AI Microservice Configuration (ai-service)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# Frontend Configuration (Vite)
VITE_API_BASE_URL=/api/v1
