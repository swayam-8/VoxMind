# ==============================================================================
# VoxMind — Environment Configuration Template
# ==============================================================================
# Run npm start to create .env and generate local secrets automatically.
# Keep the generated .env and backend/.env private.
# ==============================================================================

# Node / Backend Configuration
NODE_ENV=production
PORT=5000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Database & Cache
MONGO_URI=mongodb://mongo:27017/voxmind
REDIS_URL=redis://redis:6379/0

# Security (JWT Authentication)
# npm start generates a secure random secret when this value is empty.
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Generated by npm start; use the same value in backend and AI service.
AI_INTERNAL_SECRET=

# File Storage
UPLOAD_DIR=/app/storage/uploads
MAX_UPLOAD_SIZE_MB=100

# Local AI Microservice URL (FastAPI)
AI_SERVICE_PORT=8001
AI_SERVICE_URL=http://ai_service:8000

# AI Microservice Configuration (ai-service)
# Ollama is included in Docker Compose; no host installation is required.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# Frontend Configuration (Vite)
VITE_API_BASE_URL=/api/v1

# Optional Zoom / Google Meet / Webex recording imports
# See docs/meeting-integrations.md. Never use VITE_ prefixes for these settings.
INTEGRATION_ENCRYPTION_KEY=
INTEGRATIONS_API_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WEBEX_CLIENT_ID=
WEBEX_CLIENT_SECRET=

# Google sign-in (openid/email/profile only; separate from Drive consent).
# Can reuse GOOGLE_CLIENT_ID/SECRET if these are empty.
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
AUTH_API_BASE_URL=http://localhost:5000
